# ─────────────────────────────────────────────────────────────────────────────
# Copy to ".env" and fill in. Never commit the real .env.
# Shared by BOTH variants (chat + terminal). Each variant uses the bits it needs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────────────────────

# Claude auth (Pro/Max subscription).
# On any machine that has Claude Code installed and is logged into your
# Pro/Max account, run:   claude setup-token
# Copy the printed token (starts with sk-ant-oat01-...) here.
CLAUDE_CODE_OAUTH_TOKEN=

# Synology file ownership. SSH into the NAS and run `id` as your user to confirm.
# 1026/100 are typical for the first Synology admin user + the "users" group.
PUID=1026
PGID=100

# Host paths on the NAS. Create these folders first (see README) and make sure
# WORKSPACE_DIR and CONFIG_DIR are owned by PUID:PGID.
WORKSPACE_DIR=/volume1/docker/claude-nas/workspace
CONFIG_DIR=/volume1/docker/claude-nas/config

# ── Variant 1: Chat (Open WebUI) — docker-compose.yml ────────────────────────

# Shared secret between Open WebUI and the bridge. Use a long random string.
# Generate one, e.g.:   openssl rand -hex 32
BRIDGE_API_KEY=change-me-to-a-long-random-string

# Open WebUI's own data dir + the port you reach the chat UI on.
WEBUI_DATA_DIR=/volume1/docker/claude-nas/webui
WEBUI_PORT=3000

# Default model alias: sonnet | opus | haiku  (or a full id like claude-sonnet-4-6)
CLAUDE_MODEL=sonnet

# Safety / behavior for the chat agent.
#   bypassPermissions -> agent acts unattended inside the sandbox (default).
#   dontAsk           -> agent may only use tools listed in ALLOWED_TOOLS.
CLAUDE_PERMISSION_MODE=bypassPermissions
ALLOWED_TOOLS=
SHOW_TOOL_CALLS=true
MAX_TURNS=40

# ── Variant 2: Terminal (ttyd) — docker-compose.terminal.yml ─────────────────

# REQUIRED for the terminal variant — it exposes a shell, so protect it.
TTYD_USER=admin
TTYD_PASS=change-me-too-long-and-random
TTYD_PORT=7681
# What opens in the browser terminal: bash (default, type `claude`) or claude.
TTYD_SHELL=bash
